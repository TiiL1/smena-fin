# Скопируй этот файл в .env и заполни своими значениями (только для локального запуска —
# на Render эти же переменные задаются в разделе Environment, .env туда не загружается).

# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Публичный URL, на котором будет жить приложение (Render выдаст его сам после деплоя,
# впиши сюда уже когда будет известен, вида https://smena-fin.onrender.com)
WEBAPP_URL=

# Строка подключения к Neon Postgres (пункт "Connection string" в Neon, pooled-вариант)
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Произвольная длинная случайная строка — секрет для эндпоинта напоминаний,
# чтобы его не мог дёрнуть кто попало
CRON_SECRET=change-me-to-something-random

# Часовой пояс и час для напоминаний
REMINDER_TIMEZONE=Asia/Almaty
REMINDER_HOUR=10
